# LeakHub APIRadar — environment variables
# Copy this file to .env and fill in your values.

# Database URL (SQLite by default; swap for PostgreSQL in production)
DATABASE_URL=sqlite:///./leakhub.db

# GitHub Personal Access Token (optional — raises API rate limit from 10 to 30 req/min)
# Create one at https://github.com/settings/tokens (no scopes required for public search)
GITHUB_TOKEN=

# Backend server settings
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
